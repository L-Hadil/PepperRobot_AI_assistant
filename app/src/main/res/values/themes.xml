<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme sans ActionBar. -->
    <style name="Theme.PepperRobotAIassistant" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Couleurs principales -->
        <item name="colorPrimary">@color/earth_brown_light</item>
        <item name="colorPrimaryVariant">@color/earth_brown_dark</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Couleurs secondaires (Boutons, Accent) -->
        <item name="colorSecondary">@color/sun_yellow</item>
        <item name="colorSecondaryVariant">@color/sun_yellow</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Style global des boutons -->
        <item name="materialButtonStyle">@style/Widget.PepperRobotAIassistant.Button</item>

        <!-- Couleur de la barre système (statut) -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Fond d'écran général -->
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Style spécifique pour tous les boutons -->
    <style name="Widget.PepperRobotAIassistant.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/sun_yellow</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">24dp</item>
    </style>
</resources>
