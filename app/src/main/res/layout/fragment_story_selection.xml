<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/imageMamouth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/backgroundmammouth" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:layout_marginBottom="48dp">

        <Button
            android:id="@+id/buttonMammothStory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histoire de Mammouth"
            android:backgroundTint="#F4A300"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="200dp"
            android:minHeight="64dp"
            android:layout_marginBottom="16dp"/>


        <Button
            android:id="@+id/buttonNuageStory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histoire du monstre des emotions"
            android:backgroundTint="#A3D5FF"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="200dp"
            android:minHeight="64dp" />

        <Button
            android:id="@+id/buttonPepperStory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histoire de Pepper"
            android:backgroundTint="#FFA3F6"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minWidth="200dp"
            android:minHeight="64dp" />
    </LinearLayout>
</FrameLayout>
